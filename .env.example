# Phase 1 (local) configuration. Copy to .env; docker compose reads this file.
APP_ENV=local
AUTH_MODE=dev
DETECTOR=stub
# Real detector (DETECTOR=acpds_yolo): needs WORKER_EXTRAS=vision and
# `uv run python scripts/download_weights.py`. Weight paths are relative to MODELS_DIR.
# Compose sets MODELS_DIR=/app/models for the worker container.
MODELS_DIR=models
ACPDS_WEIGHTS=acpds/RCNN_128_square_gopro.pt
YOLO_WEIGHTS=yolo/yolo26m.pt
YOLO_SEG_WEIGHTS=yolo/yolo26m-seg.pt
YOLO_CONF=0.25
# YOLO inference size in px (multiple of 32, >= 320); 640 misses small, distant cars
YOLO_IMGSZ=1280
# box | box_lower_half | seg (seg loads YOLO_SEG_WEIGHTS)
YOLO_OVERLAP_MODE=box
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin

# Emulator endpoints as seen from inside the compose network
S3_ENDPOINT_URL=http://rustfs:9000
SQS_ENDPOINT_URL=http://elasticmq:9324
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
# Address the browser uses for presigned uploads (part of the signature)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

BUCKET_NAME=parking-local
QUEUE_NAME=parking-jobs
QUEUE_URL=http://elasticmq:9324/000000000000/parking-jobs
TABLE_NAME=parking

# Dev auth (AUTH_MODE=dev only). Change the secret before sharing a laptop.
JWT_SECRET=dev-only-change-me
JWT_TTL_MINUTES=60
DEV_ADMIN_EMAIL=admin@example.edu
DEV_ADMIN_PASSWORD=admin-password
DEV_USER_EMAIL=viewer@example.edu
DEV_USER_PASSWORD=viewer-password

# State rule cutoffs (tuned in the pilot)
CUTOFF_LOW=0.3
CUTOFF_HIGH=0.7
CUTOFF_OVERLAP=0.30
CUTOFF_MARGIN=0.05
REQUIRE_CAR_CHECK=true
