# Same stack as .env.example, seen from the host (CI runner or a laptop running seed/pytest).
APP_ENV=local
AUTH_MODE=dev
DETECTOR=stub
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
SQS_ENDPOINT_URL=http://localhost:9324
DYNAMODB_ENDPOINT_URL=http://localhost:8001
BUCKET_NAME=parking-local
QUEUE_NAME=parking-jobs
QUEUE_URL=http://localhost:9324/000000000000/parking-jobs
TABLE_NAME=parking
JWT_SECRET=dev-only-change-me
JWT_TTL_MINUTES=60
DEV_ADMIN_EMAIL=admin@example.edu
DEV_ADMIN_PASSWORD=admin-password
DEV_USER_EMAIL=viewer@example.edu
DEV_USER_PASSWORD=viewer-password
CUTOFF_LOW=0.3
CUTOFF_HIGH=0.7
CUTOFF_OVERLAP=0.30
CUTOFF_MARGIN=0.05
REQUIRE_CAR_CHECK=true
